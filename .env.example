# Local configuration. start.bat copies this to .env on first run; edit .env,
# not this file. .env is gitignored.
#
# Everything here is optional — with none of it set the app still runs, push
# still works (keys are generated into data/), and sign-in simply doesn't appear.

# Google sign-in, so watched areas follow the account instead of the browser.
# This is the OAuth *Client ID* from the Google Cloud console — a Web
# application credential. It is not a secret: the browser receives it. There is
# no client secret and no API key in this app.
# Remember to add http://localhost:4950 under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Web Push identity. Leave blank locally and a pair is generated into
# data/vapid.json on first start. Fill these in only to reuse the same identity
# as the Vercel deployment (`npm run vapid` prints the current pair).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# Shared secret for /api/cron. Unset locally means the endpoint is unprotected,
# which is fine on a laptop and not fine on a public deployment.
CRON_SECRET=

# Minutes between push cycles (default 20).
CYCLE_MINUTES=
