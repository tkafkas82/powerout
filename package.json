{
  "name": "power-outages",
  "version": "2.0.0",
  "description": "Scheduled power-outage watcher with real Web Push, backed by the DEDDIE (Greek DSO) public outages site",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/cycle.test.js",
    "cycle": "node -e \"import('./lib/cycle.js').then(m=>m.runCycle({ttl:0})).then(r=>console.log(r))\"",
    "vapid": "node -e \"import('./lib/push.js').then(m=>m.getVapid()).then(k=>console.log(k))\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "@upstash/redis": "^1.34.3"
  },
  "engines": {
    "node": ">=18"
  }
}
